# Enable developer admin tools in the UI (boolean)
VITE_DEV_ADMIN_TOOLS=false
VITE_API_URL=http://localhost:3000
FRONTEND_URL=https://ar-price.netlify.app

# Optional self-hosted LibreTranslate-compatible service URL, reachable by this backend.
# Example: http://libretranslate:5000/translate (Docker network).
# Product translations are cached in server memory and browser storage, never in Supabase.
TRANSLATION_SERVICE_URL=
TRANSLATION_SERVICE_API_KEY=

# Server-only: never expose the service role key to Vite or the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
